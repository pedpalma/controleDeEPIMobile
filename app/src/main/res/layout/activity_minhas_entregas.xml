<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margem_tela"
        android:background="@drawable/fundo_cabecalho"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/txtNomeColaborador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_minhas_entregas"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDadosColaborador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/verde_claro"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtPendentes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/amarelo_alerta"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaEntregas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margem_tela"
            android:paddingEnd="@dimen/margem_tela"
            android:paddingBottom="@dimen/margem_tela" />

        <ProgressBar
            android:id="@+id/progresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/blocoVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/tamanho_icone_vazio"
                android:layout_height="@dimen/tamanho_icone_vazio"
                android:background="@drawable/fundo_icone_circulo"
                android:importantForAccessibility="no"
                android:padding="16dp"
                android:src="@drawable/ic_entrega" />

            <TextView
                android:id="@+id/txtVazioTitulo"
                style="@style/Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/vazio_minhas_entregas_titulo"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtVazioDica"
                style="@style/Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/vazio_minhas_entregas_dica" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
