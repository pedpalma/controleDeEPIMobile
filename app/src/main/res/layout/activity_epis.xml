<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaEpis"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="@dimen/margem_tela"
        android:paddingBottom="88dp" />

    <ProgressBar
        android:id="@+id/progresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/blocoVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/tamanho_icone_vazio"
            android:layout_height="@dimen/tamanho_icone_vazio"
            android:background="@drawable/fundo_icone_circulo"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:src="@drawable/ic_epi" />

        <TextView
            android:id="@+id/txtVazioTitulo"
            style="@style/Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/vazio_epis_titulo"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtVazioDica"
            style="@style/Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/vazio_epis_dica" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
